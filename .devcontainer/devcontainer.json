{
  "name": "DecidoBien PWA",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [
    4173
  ],
  "portsAttributes": {
    "4173": {
      "label": "DecidoBien",
      "onAutoForward": "openBrowser"
    }
  },
  "postStartCommand": "nohup python3 server.py > /tmp/decidobien-server.log 2>&1 &"
}
